# Copy this file to ".env" (same folder as app.py) and fill in your real values.
# ".env" is gitignored — it will never be committed.

PETPOOJA_APP_KEY=
PETPOOJA_APP_SECRET=
PETPOOJA_ACCESS_TOKEN=
PETPOOJA_REST_ID=

# Only set these once you have PetPooja's real endpoint URLs from their docs.
# If left blank, the client falls back to the placeholder URLs in petpooja_client.py.
# PETPOOJA_BASE_URL=
# PETPOOJA_MENU_URL=
# PETPOOJA_SAVE_ORDER_URL=
# PETPOOJA_ORDER_STATUS_URL=

# --- App / production settings ---
# Random long string — required for session security. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to 0 in production (Azure/Render). Leave as 1 only for local dev.
FLASK_DEBUG=1

# Shared secret required to call /admin/sync-menu and /admin/poll-settlements.
# Generate the same way as SECRET_KEY. Without this set, those routes are
# blocked entirely (503) rather than left open.
ADMIN_TOKEN=
